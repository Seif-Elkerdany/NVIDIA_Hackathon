# Copy to .env locally; never commit .env. Environment variables override this file.
# make setup needs Python 3.12 (uv can install it), uv 0.12.23,
# Node 22.12+ or 24, pnpm 10.32.1, and GNU Make. Docker Compose is needed for dev-db.
APP_ENV=development
# disabled makes no provider calls; fixture is explicit and development/test only.
PROVIDER_MODE=disabled
DEMO_ENABLED=false
WATCH_ENABLED=false

# Choose a local-only password before make dev-db. No production credentials here.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Set to postgresql+psycopg://benefitbridge:<URL-encoded-password>@127.0.0.1:5432/benefitbridge
DATABASE_URL=

# Required with APP_ENV=production and PROVIDER_MODE=real.
SUPABASE_URL=
JWT_ISSUER=
JWT_JWKS_URL=
JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Independent random secrets of at least 32 characters.
DELETION_HMAC_KEY=
RECEIPT_ENCRYPTION_KEY=
